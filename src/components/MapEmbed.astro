---
import Icon from './Icon.astro';
import { getSettings } from '../lib/site';

const settings = await getSettings();
const { address, mapsUrl } = settings;
const query = encodeURIComponent('Królewiecka 121 Wrocław');
const embedSrc = `https://maps.google.com/maps?q=${query}&output=embed`;
---

<div class="map" data-map data-src={embedSrc}>
  <div class="map__placeholder">
    <svg class="map__grid" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path d="M-20 210 C 80 170, 140 250, 240 190 S 380 120, 440 150" />
      <path d="M60 -10 C 90 90, 60 160, 130 320" />
      <path d="M250 -10 C 230 80, 300 150, 270 320" />
      <path d="M-20 90 C 100 110, 200 60, 440 90" />
    </svg>
    <div class="map__card">
      <span class="map__pin"><Icon name="pin" size={28} /></span>
      <p class="map__addr">
        <strong>{settings.name}</strong>
        <span>{address.street}</span>
        <span>{address.postalCode} {address.city}</span>
      </p>
      <div class="map__actions">
        <button type="button" class="btn btn--primary" data-map-load>
          <span>Załaduj mapę</span>
          <Icon name="arrow-up-right" />
        </button>
        <a class="btn btn--ghost" href={mapsUrl} target="_blank" rel="noopener">
          <span>Otwórz w Google Maps</span>
          <Icon name="arrow-up-right" />
          <span class="visually-hidden">(nowa karta)</span>
        </a>
      </div>
      <p class="map__note xs muted">Mapa ładuje się dopiero po kliknięciu – wtedy połączymy się z serwerami Google.</p>
    </div>
  </div>
</div>

<style>
  .map {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-l);
    border: 1px solid var(--color-line);
    background: var(--color-khaki-pale);
    /* Stała szerokość: inaczej aspect-ratio + min-height rozpychały mapę (i stronę) na telefonie. */
    width: 100%;
    min-height: 24rem;
    aspect-ratio: 16 / 10;
  }
  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-m);
    background:
      radial-gradient(60% 70% at 20% 20%, var(--color-khaki-pale), transparent 70%),
      radial-gradient(50% 60% at 85% 80%, var(--color-sand), transparent 70%),
      var(--color-cream);
  }
  .map__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-khaki);
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .map__card {
    position: relative;
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;
    max-width: 24rem;
    padding: var(--space-l);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
  }
  .map__pin {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-olive);
    color: var(--color-khaki-light);
  }
  .map__addr {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .map__addr strong {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-xl);
    color: var(--color-ink);
  }
  .map__actions {
    display: grid;
    gap: var(--space-2xs);
    width: 100%;
  }
  .map__note {
    max-width: 20rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-map-load]');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = root.dataset.src ?? '';
      iframe.title = 'Mapa Google – lokalizacja gabinetu Si Skin, ul. Królewiecka 121/3, Wrocław';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      root.querySelector('.map__placeholder')?.replaceWith(iframe);
    });
  });
</script>
