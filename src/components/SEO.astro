---
import { getImage } from 'astro:assets';
import { absoluteUrl, getSettings, url } from '../lib/site';
import { localBusinessSchema, ogImagePath } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Ścieżka bez base, np. '/cennik/'. */
  path: string;
  image?: ImageMetadata | string;
  jsonLd?: object[];
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, path, image, jsonLd = [], noindex = false, type = 'website' } = Astro.props;
const settings = await getSettings();
const site = Astro.site;

const fullTitle = /si\s?skin/i.test(title) ? title : `${title} | ${settings.name}`;
const canonical = absoluteUrl(path, site);

/** Domyślny obraz OG generuje Platform; strony noindex (404) dostają obraz domyślny. */
const ogPath = noindex ? '/og/default.png' : ogImagePath(path);

let ogImage: string;
if (typeof image === 'string') {
  ogImage = /^https?:/.test(image) ? image : absoluteUrl(image, site);
} else if (image) {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
  ogImage = new URL(og.src, site).href;
} else {
  ogImage = absoluteUrl(ogPath, site);
}

const markdownHref = url(`${path.endsWith('/') ? path : `${path}/`}index.md`);
const graph = [localBusinessSchema(settings, site as URL), ...jsonLd];
const serialize = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
<link rel="alternate" type="text/markdown" href={markdownHref} />

<meta property="og:site_name" content={settings.name} />
<meta property="og:locale" content="pl_PL" />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{graph.map((data) => <script type="application/ld+json" set:html={serialize(data)} />)}
