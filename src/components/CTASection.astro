---
import { Picture } from 'astro:assets';
import bg from '../assets/images/liscie-cien.jpg';
import BookingButton from './BookingButton.astro';
import Icon from './Icon.astro';
import { getSettings } from '../lib/site';

interface Props {
  title?: string;
  text?: string;
  /** Placement przycisku Booksy (unikalny na stronie). */
  placement: string;
}
const settings = await getSettings();
const {
  title = settings.tagline,
  text = 'Wybierz termin w Booksy albo zadzwoń i powiedz, co chciałabyś zmienić. Podpowiemy, od czego zacząć.',
  placement,
} = Astro.props;
---

<section class="cta" aria-labelledby={`cta-${placement}`}>
  <div class="container">
    <div class="card-cta" data-reveal="scale">
      <div class="bg" data-parallax aria-hidden="true">
        <Picture
          src={bg}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 76rem) 76rem, 100vw"
          loading="lazy"
          decoding="async"
          quality={60}
        />
      </div>
      <div class="overlay" aria-hidden="true"></div>
      <div class="content">
        <h2 id={`cta-${placement}`}>{title}</h2>
        <p>{text}</p>
        <div class="actions">
          <BookingButton placement={placement} variant="on-dark" size="lg" />
          <a class="phone" href={`tel:${settings.phoneHref}`}>
            <Icon name="phone" size={18} />
            <span>{settings.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-section);
  }
  .card-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
    color: var(--color-on-dark);
    background: var(--color-olive-deep);
    text-align: center;
  }
  .bg,
  .overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .bg :global(picture),
  .bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay {
    background:
      radial-gradient(60% 80% at 50% 50%, color-mix(in srgb, var(--color-olive-deep) 62%, transparent), transparent 100%),
      color-mix(in srgb, var(--color-olive-deep) 66%, transparent);
  }
  .content {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    padding: clamp(3.5rem, 2rem + 8vw, 8rem) var(--gutter);
  }
  h2 {
    font-size: var(--text-4xl);
    max-width: 16ch;
  }
  p {
    max-width: 34rem;
    color: var(--color-on-dark-soft);
    font-size: var(--text-lg);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin-top: var(--space-xs);
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding-inline: var(--space-2xs);
    color: var(--color-on-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-on-dark);
    transition: border-color var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .phone:hover { border-color: var(--color-khaki-light); }
  }
</style>
