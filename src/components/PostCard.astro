---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, url } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  /** Poziom nagłówka tytułu (h2 na liście bloga, h3 w sekcjach pod h2). */
  level?: 2 | 3;
}

const { post, index = 0, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const { title, description, image, imageAlt, pubDate } = post.data;
---

<article class="post-card" data-reveal style={`--i:${Math.min(index, 5)}`}>
  <a class="post-card__link" href={url(`/blog/${post.id}/`)}>
    <div class="post-card__media media">
      <Picture
        src={image}
        alt={imageAlt}
        formats={['avif', 'webp']}
        widths={[360, 540, 760]}
        sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
        loading="lazy"
        decoding="async"
        width={760}
        height={507}
        fit="cover"
      />
    </div>
    <div class="post-card__body">
      <time class="xs muted" datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      <Heading class="post-card__title">{title}</Heading>
      <p class="small muted">{description}</p>
      <span class="link-arrow">Czytaj artykuł</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    height: 100%;
  }
  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    overflow: hidden;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .post-card__link:active {
    transform: scale(0.985);
  }
  .post-card__media {
    aspect-ratio: 3 / 2;
    border-radius: 0;
  }
  .post-card__media :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .post-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-m);
    flex: 1;
  }
  .post-card__title {
    font-size: var(--text-xl);
  }
  .post-card__body .link-arrow {
    margin-top: auto;
  }
  @media (hover: hover) and (pointer: fine) {
    .post-card__link:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-m);
    }
    .post-card__link:hover .post-card__media :global(img) {
      transform: scale(1.05);
    }
    .post-card__link:hover .link-arrow {
      border-color: var(--color-ink);
      gap: 0.7em;
    }
  }
</style>
