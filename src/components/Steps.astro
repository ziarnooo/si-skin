---
import Icon, { type IconName } from './Icon.astro';

interface Step {
  title: string;
  text: string;
  icon?: IconName;
}
interface Props {
  steps?: Step[];
}
const defaultSteps: Step[] = [
  {
    title: 'Rezerwacja',
    text: 'Wybierasz termin w Booksy albo dzwonisz do nas: 516 070 508. Wizyty realizujemy po wcześniejszej rezerwacji.',
    icon: 'calendar',
  },
  {
    title: 'Wywiad i konsultacja',
    text: 'Zaczynamy od rozmowy i oceny stanu Twojej skóry. Bezpłatna konsultacja trwa 20 minut – rozwiewamy wątpliwości i ustalamy plan działania.',
    icon: 'user',
  },
  {
    title: 'Zabieg',
    text: 'Dobieramy parametry do karnacji, koloru włosa i Twoich odczuć. Każdy krok tłumaczymy na bieżąco.',
    icon: 'sparkle',
  },
  {
    title: 'Zalecenia i plan',
    text: 'Dostajesz zalecenia na po zabiegu. Przy depilacji laserowej dokładny plan serii ustalamy właśnie na pierwszej wizycie.',
    icon: 'leaf',
  },
];
const { steps = defaultSteps } = Astro.props;
---

<ol class="steps" role="list" style={`--steps:${steps.length}`}>
  {
    steps.map((step, index) => (
      <li class="step" data-reveal style={`--i:${index % 2}`}>
        <span class="step__dot" aria-hidden="true">
          <Icon name={step.icon ?? 'hexagon'} size={20} />
        </span>
        <div class="step__body">
          <span class="step__num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    --line-x: 1.375rem;
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-l);
  }
  .steps::before,
  .steps::after {
    content: '';
    position: absolute;
    left: var(--line-x);
    top: 1.375rem;
    bottom: 1.375rem;
    width: 1px;
    transform: translateX(-50%);
  }
  .steps::before { background: var(--color-line-strong); }
  .steps::after {
    width: 2px;
    background: var(--gradient-gold);
    transform: translateX(-50%);
    transform-origin: top;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--space-m);
    align-items: start;
  }
  .step__dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-paper);
    border: 1px solid var(--color-gold);
    color: var(--color-gold-text);
  }
  .step__body {
    padding-bottom: var(--space-xs);
  }
  .step__num {
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-gold-text);
  }
  .step__title {
    margin-top: 0.15rem;
    font-size: var(--text-xl);
  }
  .step__text {
    margin-top: var(--space-2xs);
    color: var(--color-ink-soft);
    max-width: 32rem;
  }

  @media (min-width: 52rem) {
    .steps {
      --line-x: 50%;
      gap: var(--space-xl);
    }
    .step {
      grid-template-columns: 1fr 2.75rem 1fr;
      gap: var(--space-xl);
    }
    .step__dot { grid-column: 2; grid-row: 1; }
    .step__body { grid-column: 3; grid-row: 1; }
    .step:nth-child(odd) .step__body { grid-column: 1; text-align: right; }
    .step:nth-child(odd) .step__text { margin-left: auto; }
  }

  /* Linia postępu wypełnia się wraz ze scrollem (CSS scroll-driven; bez wsparcia – linia od razu pełna) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .steps::after {
        transform: translateX(-50%) scaleY(0);
        animation: steps-fill linear both;
        animation-timeline: view();
        animation-range: entry 35% exit 55%;
      }
      .step__dot {
        animation: step-dot linear both;
        animation-timeline: view();
        animation-range: entry 55% entry 95%;
      }
    }
  }
  @keyframes steps-fill {
    to { transform: translateX(-50%) scaleY(1); }
  }
  @keyframes step-dot {
    from { background: var(--color-paper); color: var(--color-gold-text); }
    to { background: var(--color-green); color: var(--color-gold-light); border-color: var(--color-green); }
  }
</style>
