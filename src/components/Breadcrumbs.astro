---
import { url } from '../lib/site';

interface Props {
  /** Ścieżka BEZ strony głównej — „Strona główna” dodajemy automatycznie. Ostatni element = bieżąca strona. */
  items: { name: string; path: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
const trail = [{ name: 'Strona główna', path: '/' }, ...items];
---

<nav class:list={['crumbs', className]} aria-label="Ścieżka nawigacji">
  <ol>
    {
      trail.map((item, i) => {
        const last = i === trail.length - 1;
        return (
          <li>
            {last ? (
              <span aria-current="page">{item.name}</span>
            ) : (
              <a href={url(item.path)}>{item.name}</a>
            )}
            {!last && (
              <svg class="sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs) var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-width: 0;
  }
  a {
    text-decoration: none;
    padding-block: 0.4rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) {
    a:hover { color: var(--color-ink); text-decoration: underline; }
  }
  .sep { opacity: 0.55; flex: none; }
  [aria-current='page'] {
    color: var(--color-ink-soft);
    display: inline-block;
    max-width: 32ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
  @media (max-width: 30rem) {
    [aria-current='page'] { max-width: 20ch; }
  }
</style>
