---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { url } from '../../lib/site';
import gabinet1 from '../../assets/images/gabinet-1.jpg';
import specjalistka from '../../assets/images/specjalistka-laser.jpg';
import gabinet2 from '../../assets/images/gabinet-2.jpg';

const text =
  'Chcemy, żebyś wybrała Si Skin nie dlatego, że znalazłaś najtańszy gabinet, ale dlatego, że znalazłaś swoje miejsce. Takie, w którym ufasz niezmiennej jakości, czujesz się rozumiana i wiesz, że ktoś naprawdę potrafi o Ciebie zadbać. Zaczynamy od rozmowy o tym, z czym przychodzisz, a dopiero potem dobieramy zabieg.';

const photos = [
  { src: gabinet1, alt: 'Wnętrze gabinetu Si Skin we Wrocławiu', class: 'photo--l' },
  { src: specjalistka, alt: 'Kosmetolożka podczas zabiegu laserowego', class: 'photo--c' },
  { src: gabinet2, alt: 'Stanowisko zabiegowe w gabinecie Si Skin', class: 'photo--r' },
];
---

<section class="section about" id="o-si-skin" aria-labelledby="about-title">
  <div class="container container--narrow about__inner">
    <span class="eyebrow eyebrow--plain" data-reveal>O Si Skin</span>
    <h2 id="about-title" class="visually-hidden">O gabinecie Si Skin</h2>
    <p class="about__text" data-words>{text}</p>
    <a class="btn btn--ghost" href={url('/o-nas/')} data-reveal>
      Poznaj nas bliżej
      <Icon name="arrow" />
    </a>
  </div>

  <div class="container about__photos" aria-hidden="true">
    {
      photos.map((photo, index) => (
        <div class={`photo media ${photo.class}`} data-reveal="scale" style={`--i:${index}`}>
          <Picture
            src={photo.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[320, 480, 640]}
            sizes="(min-width: 48rem) 30vw, 40vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .about { overflow: clip; }
  .about__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    text-align: center;
    /* szerszy niż domyślne „narrow” – duży akapit potrzebuje oddechu */
    width: min(100% - 2 * var(--gutter), 62rem);
  }
  .about__text {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    text-wrap: balance;
  }
  @media (min-width: 48rem) {
    .about__text { font-size: var(--text-3xl); line-height: 1.2; }
  }
  .about__photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-xs);
    margin-top: var(--space-2xl);
  }
  .photo { aspect-ratio: 3 / 4; border-radius: var(--radius-m); box-shadow: var(--shadow-photo); }
  .photo--l { rotate: -3deg; translate: 0 1rem; }
  .photo--r { rotate: 3deg; translate: 0 1rem; }
  .photo--c { aspect-ratio: 3 / 4.4; z-index: 1; }
  @media (min-width: 48rem) {
    .about__photos { gap: var(--space-m); padding-inline: 8%; }
    .photo { border-radius: var(--radius-l); }
  }
</style>
