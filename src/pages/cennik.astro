---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PriceTable from '../components/PriceTable.astro';
import Promotions from '../components/Promotions.astro';
import BookingButton from '../components/BookingButton.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import { formatDate, getSettings, isActive, url } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const [settings, pricing, services, promotions] = await Promise.all([
  getSettings(),
  getCollection('pricing'),
  getCollection('services'),
  getCollection('promotions'),
]);
const categories = [...pricing].sort((a, b) => a.data.order - b.data.order);
const serviceIds = new Set(services.map((s) => s.id));
const hasPromos = promotions.some((p) => isActive(p.data));
const crumbs = [{ name: 'Cennik', path: '/cennik/' }];
---

<Base
  title="Cennik zabiegów laserowych i kosmetologicznych | Si Skin"
  description="Aktualny cennik gabinetu Si Skin we Wrocławiu: depilacja laserowa SHR, zamykanie naczynek, przebarwienia, oczyszczanie wodorowe, stymulatory, modelowanie ust."
  path="/cennik/"
  jsonLd={[breadcrumbSchema([{ name: 'Strona główna', path: '/' }, ...crumbs], Astro.site)]}
>
  <PageHero
    eyebrow="Ceny brutto"
    title="Cennik"
    lead="Przejrzysta lista zabiegów z czasem trwania i ceną. Ceny weryfikujemy na bieżąco z ofertą w Booksy, gdzie od razu umówisz wizytę."
    breadcrumbs={crumbs}
    booking="cennik-top"
  >
    <span class="chip chip--paper">
      <Icon name="check-circle" />
      Aktualizacja: {formatDate(settings.rating.checkedAt)}
    </span>
  </PageHero>

  <nav class="spy" aria-label="Kategorie cennika" data-spy>
    <div class="spy__bar">
      <div class="spy__scroller" data-spy-scroller>
        <ul role="list" class="spy__list">
          {
            categories.map((c) => (
              <li>
                <a class="spy__link" href={`#${c.id}`}>{c.data.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>

  <section class="section section--tight" aria-label="Cennik zabiegów">
    <div class="container">
      <div class="stack-l">
        {
          categories.map((c) => (
            <div class="cat">
              <PriceTable category={c} level={2} open />
              <div class="cat__actions">
                <BookingButton placement={`cennik-${c.id}`} service={c.data.service} />
                {c.data.service && serviceIds.has(c.data.service) && (
                  <a class="link-arrow" href={url(`/${c.data.service}/`)}>
                    Opis zabiegu
                    <Icon name="arrow" size={16} />
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <aside class="packages card" data-reveal>
        <Icon name="gift" size={26} />
        <p>
          <strong class="serif">Pakiety zabiegów.</strong>
          Pakiety na serię zabiegów depilacji laserowej kupisz na miejscu w gabinecie – zapytaj o nie podczas wizyty lub bezpłatnej konsultacji.
        </p>
      </aside>
    </div>
  </section>

  {
    hasPromos && (
      <section class="section section--cream" aria-labelledby="promocje-h">
        <div class="container">
          <div class="section-head section-head--split" data-reveal>
            <h2 id="promocje-h">Promocje</h2>
            <p class="muted">
              Zniżki za polecenie, opinię, selfie i karta stałego klienta. <a href={url('/promocje/')}>Wszystkie promocje i zasady</a>
            </p>
          </div>
          <Promotions limit={2} />
        </div>
      </section>
    )
  }

  <CTASection placement="cennik-bottom" />
</Base>

<style>
  @property --fade-start {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @property --fade-end {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  /* Przezroczysty, lepki wrapper: dokładnie taki sam inset jak pływający pasek nagłówka */
  .spy {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    margin-top: var(--radius-xl);
    padding: var(--space-2xs) var(--gutter) 0;
    pointer-events: none;
  }
  .spy__bar {
    pointer-events: auto;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-paper) 78%, transparent);
    box-shadow: var(--shadow-m);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    backdrop-filter: blur(16px) saturate(1.5);
  }
  .spy__scroller {
    --fade-size: 2.5rem;
    position: relative;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--color-ink) var(--fade-start),
      var(--color-ink) calc(100% - var(--fade-end)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--color-ink) var(--fade-start),
      var(--color-ink) calc(100% - var(--fade-end)),
      transparent 100%
    );
    transition:
      --fade-start var(--dur) var(--ease-out),
      --fade-end var(--dur) var(--ease-out);
  }
  .spy[data-fade-start] .spy__scroller {
    --fade-start: var(--fade-size);
  }
  .spy[data-fade-end] .spy__scroller {
    --fade-end: var(--fade-size);
  }
  .spy__scroller::-webkit-scrollbar {
    display: none;
  }
  .spy__list {
    display: flex;
    gap: var(--space-2xs);
    width: max-content;
    min-width: 100%;
    padding: 0.375rem;
    justify-content: safe center;
  }
  .spy__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-ivory);
    font-size: var(--text-xs);
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-ink-soft);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }
  .spy__link:active {
    transform: scale(0.97);
  }
  .spy__link[aria-current='true'] {
    background: var(--color-green);
    border-color: var(--color-green);
    color: var(--color-on-dark);
  }
  @media (hover: hover) and (pointer: fine) {
    .spy__link:hover:not([aria-current='true']) {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }
  .cat__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-s) var(--space-xs) 0;
  }
  .packages {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    margin-top: var(--space-xl);
    background: var(--color-sage-light);
    border-color: transparent;
  }
  .packages :global(svg) {
    flex: none;
    color: var(--color-green);
  }
  .packages strong {
    font-weight: 400;
    margin-right: 0.35em;
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-spy]');
  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
    const scroller = nav.querySelector<HTMLElement>('[data-spy-scroller]');
    const visible = new Set<string>();
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = '';

    // Miękkie krawędzie tylko po tej stronie, w którą da się jeszcze przewinąć
    let fadeFrame = 0;
    const updateFades = () => {
      fadeFrame = 0;
      if (!scroller) return;
      const max = scroller.scrollWidth - scroller.clientWidth;
      nav.toggleAttribute('data-fade-start', scroller.scrollLeft > 1);
      nav.toggleAttribute('data-fade-end', scroller.scrollLeft < max - 1);
    };
    const queueFades = () => {
      if (!fadeFrame) fadeFrame = requestAnimationFrame(updateFades);
    };
    if (scroller) {
      scroller.addEventListener('scroll', queueFades, { passive: true });
      new ResizeObserver(queueFades).observe(scroller);
      updateFades();
    }

    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a) => {
        if (a === byId.get(id)) {
          a.setAttribute('aria-current', 'true');
          if (scroller) {
            const left = a.offsetLeft - (scroller.clientWidth - a.offsetWidth) / 2;
            scroller.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          }
        } else {
          a.removeAttribute('aria-current');
        }
      });
    };

    const targets = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const first = targets.find((t) => visible.has(t.id));
        if (first) setCurrent(first.id);
      },
      { rootMargin: '-25% 0px -55% 0px' },
    );
    targets.forEach((t) => observer.observe(t));

    const hash = location.hash.slice(1);
    if (hash) document.getElementById(hash)?.setAttribute('open', '');
  }
</script>
